{
  "name": "tuprel-vscode",
  "displayName": "TUPREL",
  "description": "TUPREL schema highlighting, diagnostics and official formatting.",
  "version": "0.1.0",
  "publisher": "tuprel",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tuprel/tuprel-editors.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax and snippets are available. Running the local Java server requires workspace trust.",
      "restrictedConfigurations": [
        "tuprel.server.javaPath",
        "tuprel.server.distributionPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Syntax and snippets are available. The Java server requires a local workspace."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "tuprel",
        "aliases": [
          "TUPREL",
          "tuprel"
        ],
        "extensions": [
          ".tuprel"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tuprel-light.svg",
          "dark": "./icons/tuprel-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tuprel",
        "scopeName": "source.tuprel",
        "path": "./syntaxes/tuprel.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tuprel",
        "path": "./snippets/tuprel.json"
      }
    ],
    "commands": [
      {
        "command": "tuprel.restartLanguageServer",
        "title": "TUPREL: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "TUPREL",
      "properties": {
        "tuprel.server.javaPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to a Java 21 executable (java.exe on Windows)."
        },
        "tuprel.server.distributionPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to an official TUPREL Language Server installation directory containing lib/."
        }
      }
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:tuprel"
  ]
}
